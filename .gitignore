# Environment and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
build/
dist/

# A report is generated output, so it is not committed. What produces it — the
# script the agent writes — is the record, and DESIGN.md's byte-identical
# guarantee means the page can be rebuilt whenever it is wanted again.
reports/*.html
# `report.html` is the output name every snippet in this repository uses, so a
# snippet run from the repo root drops one here. Root-only on purpose: `/` keeps a
# checked-in HTML somewhere else from vanishing under a wildcard.
/report.html

# Local MLflow tracking stores from ad-hoc publishes (`file:mlruns` experiments)
mlruns/

# Local tool settings: this workspace's permission grants and scratch, not the
# project's. The skill that ships lives in skills/, not here.
.claude/
.qwen/
